---
import { Icon } from 'astro-icon/components';
const { navData, rightMenu } = Astro.props;

// Indicatore di pagina corrente: senza, l'utente non sa dove si trova.
const strip = (p) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const current = strip(Astro.url.pathname);
// 'page' sulla pagina esatta, 'true' sulle sezioni che la contengono: in
// /scuola/corsi "I nostri corsi" e' la pagina, "La scuola" la sezione.
const statoCorrente = (slug) => {
	const s = strip(slug);
	if (s === '/') return current === '/' ? 'page' : undefined;
	if (current === s) return 'page';
	if (current.startsWith(s + '/')) return 'true';
	return undefined;
};
---

<script type="module">
	const bodyElement = document.querySelector('body');
	const menuButton = document.querySelector('#menuButton');
	const navHeader = document.querySelector('#odysseyNavHeader');
	const menuButtonIconHam = document.querySelector('#menuButtonIconHam');
	const menuButtonIconClose = document.querySelector('#menuButtonIconClose');
	let scrollPosition = 0;

	menuButton.addEventListener('click', toggleMenu);

	function toggleMenu() {
		menuButtonIconHam.toggleAttribute('hidden');
		menuButtonIconClose.toggleAttribute('hidden');

		const isOpen = navHeader.hasAttribute('mobile-menu-open');

		if (isOpen) {
			menuButton.title = 'Apri il menu principale';
			menuButton.setAttribute('aria-expanded', 'false');
			bodyElement.style.removeProperty('overflow');
			bodyElement.style.removeProperty('position');
			bodyElement.style.removeProperty('top');
			bodyElement.style.removeProperty('width');
			window.scrollTo(0, scrollPosition);
		} else {
			menuButton.title = 'Chiudi il menu principale';
			menuButton.setAttribute('aria-expanded', 'true');
			scrollPosition = window.pageYOffset;
			bodyElement.style.overflow = 'hidden';
			bodyElement.style.position = 'fixed';
			bodyElement.style.top = `-${scrollPosition}px`;
			bodyElement.style.width = '100%';
			// L'overlay parte da sotto la barra, che con la striscia degli
			// annunci in cima alla pagina non sta a top: 0.
			navHeader.style.setProperty(
				'--menu-top',
				`${Math.max(0, navHeader.getBoundingClientRect().bottom)}px`
			);
		}

		navHeader.toggleAttribute('mobile-menu-open');
	}

	// Ombra dell’header solo quando la pagina e' effettivamente scrollata
	const onScroll = () => {
		navHeader.toggleAttribute('scrolled', window.scrollY > 8);
	};
	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });

	// Sottomenu (desktop): la freccia accanto alla voce lo apre e lo chiude.
	// Il passaggio del mouse lo apre via CSS; questo serve a tastiera e touch.
	const gruppi = document.querySelectorAll('.nav-voce--gruppo');
	const chiudiSottomenu = () => {
		gruppi.forEach((gruppo) => {
			gruppo.removeAttribute('data-aperto');
			gruppo
				.querySelector('.nav-sub__toggle')
				?.setAttribute('aria-expanded', 'false');
		});
	};
	gruppi.forEach((gruppo) => {
		const toggle = gruppo.querySelector('.nav-sub__toggle');
		toggle?.addEventListener('click', () => {
			const aperto = toggle.getAttribute('aria-expanded') === 'true';
			chiudiSottomenu();
			if (!aperto) {
				gruppo.setAttribute('data-aperto', '');
				toggle.setAttribute('aria-expanded', 'true');
			}
		});
		gruppo.addEventListener('focusout', (e) => {
			if (e.relatedTarget && !gruppo.contains(e.relatedTarget)) chiudiSottomenu();
		});
	});
	document.addEventListener('click', (e) => {
		if (!e.target.closest('.nav-voce--gruppo')) chiudiSottomenu();
	});
	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		const aperto = document.querySelector(
			'.nav-voce--gruppo[data-aperto] .nav-sub__toggle'
		);
		chiudiSottomenu();
		aperto?.focus();
	});
</script>

<header id="odysseyNavHeader" class={rightMenu ? 'header--right' : undefined}>
	<div class="header-logo-menu__container">
		<button
			id="menuButton"
			type="button"
			title="Apri il menu principale"
			aria-label="Apri il menu principale"
			aria-expanded="false"
			aria-controls="mainNav"
		>
			<span id="menuButtonIconHam">
				<Icon name="ic:baseline-menu" width={24} height={24} />
			</span>
			<span id="menuButtonIconClose" hidden>
				<Icon name="ic:baseline-close" width={24} height={24} />
			</span>
		</button>
		<a class="header-logo__link" href="/">
			<slot name="logo" />
		</a>
	</div>
	<div class="header-nav__container" id="mainNav">
		<slot name="nav">
			{
				navData && (
					<nav aria-label="Menu principale">
						<ul>
							{navData.map((navItem, i) => (
								<li class:list={[navItem.figli?.length && 'nav-voce--gruppo']}>
									<div class="nav-voce">
										<a href={navItem.slug} aria-current={statoCorrente(navItem.slug)}>
											{navItem.icona && (
												<Icon
													class="nav-icona"
													name={navItem.icona}
													width={22}
													height={22}
													aria-hidden="true"
												/>
											)}
											<span>{navItem.title}</span>
										</a>
										{navItem.figli?.length > 0 && (
											<button
												type="button"
												class="nav-sub__toggle"
												aria-expanded="false"
												aria-controls={`navSub${i}`}
												aria-label={`Altre pagine: ${navItem.title}`}
											>
												<Icon
													name="lucide:chevron-down"
													width={16}
													height={16}
													aria-hidden="true"
												/>
											</button>
										)}
									</div>
									{navItem.figli?.length > 0 && (
										<ul class="nav-sub" id={`navSub${i}`}>
											{navItem.figli.map((figlio) => (
												<li>
													<a href={figlio.slug} aria-current={statoCorrente(figlio.slug)}>
														{figlio.title}
													</a>
												</li>
											))}
										</ul>
									)}
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</slot>
	</div>
	<div class="header-action-item__container">
		<slot name="action-item" />
	</div>
</header>

<style>
	header {
		width: 100%;
		min-height: var(--navbar-height);
		padding: var(--space-sm) clamp(1.25rem, 5vw, 3rem);
		display: flex;
		justify-content: space-between;
		align-items: center;
		position: sticky;
		top: 0;
		z-index: var(--z-sticky);
		background-color: color-mix(in srgb, var(--theme-bg) 82%, transparent);
		backdrop-filter: saturate(140%) blur(14px);
		-webkit-backdrop-filter: saturate(140%) blur(14px);
		border-bottom: 1px solid transparent;
		transition: border-color var(--theme-transition),
			background-color var(--theme-transition);
	}
	header[scrolled] {
		border-bottom-color: var(--theme-border);
		background-color: color-mix(in srgb, var(--theme-bg) 92%, transparent);
	}
	/*
	  Con il menu aperto niente backdrop-filter: un filtro sull'antenato rende
	  l'header il containing block dei figli position: fixed, e l'overlay a tutto
	  schermo si riduce alla barra. Spento qui, torna a coprire lo schermo.
	*/
	header[mobile-menu-open] {
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		background-color: transparent;
		border-bottom-color: transparent;
	}
	header.header--right {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: var(--space-md);
		align-items: center;
	}
	.header-nav__container {
		justify-self: end;
	}
	.header-logo__link {
		width: fit-content;
		color: inherit;
		text-decoration: none;
		display: flex;
		align-items: center;
	}
	.header-logo-menu__container {
		display: flex;
		align-items: center;
		z-index: var(--z-sticky);
	}
	.header-action-item__container {
		z-index: var(--z-sticky);
	}
	#menuButton {
		border: none;
		background-color: transparent;
		margin-right: var(--space-2xs);
		display: none;
		cursor: pointer;
		padding: 0.35rem;
		border-radius: var(--radius-sm);
		-webkit-tap-highlight-color: transparent;
	}
	#menuButton > span {
		color: var(--theme-on-bg);
		vertical-align: middle;
		display: block;
	}
	nav {
		display: flex;
	}
	nav ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		gap: clamp(0.75rem, 1.8vw, 1.75rem);
	}
	nav ul li {
		max-width: none;
	}
	/* Nella barra del desktop le icone sarebbero rumore: compaiono solo nel
	   menu a tutto schermo del telefono. */
	.nav-icona {
		display: none;
	}

	nav ul li a {
		position: relative;
		display: block;
		padding: 0.35rem 0;
		/* "Chi siamo" e "La scuola" non devono andare a capo nella barra */
		white-space: nowrap;
		text-decoration: none;
		color: inherit;
		font-size: var(--font-size-sm);
		font-weight: 500;
		opacity: 0.68;
		transition: opacity var(--theme-transition);
	}
	nav ul li a:hover {
		opacity: 1;
	}
	/* Filetto in ottone: unico segnale di pagina corrente */
	nav ul li a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -2px;
		height: 2px;
		background-color: var(--theme-accent);
		border-radius: 2px;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 320ms var(--ease-out);
	}
	/* [aria-current] e non ='page': anche la sezione ("La scuola" mentre si
	   guarda un corso) resta segnata */
	nav ul li a[aria-current] {
		opacity: 1;
		font-weight: 600;
	}
	nav ul li a[aria-current]::after {
		transform: scaleX(1);
	}

	/* ---- Sottomenu ---- */
	.nav-voce {
		display: flex;
		align-items: center;
		gap: var(--space-3xs);
	}
	.nav-voce--gruppo {
		position: relative;
	}
	.nav-sub__toggle {
		display: flex;
		padding: 0.25rem;
		border: none;
		border-radius: var(--radius-xs);
		background: transparent;
		color: inherit;
		opacity: 0.68;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition: opacity var(--theme-transition);
	}
	.nav-sub__toggle:hover,
	.nav-sub__toggle[aria-expanded='true'] {
		opacity: 1;
	}
	.nav-sub__toggle :global(svg) {
		transition: transform 200ms var(--ease-out);
	}
	.nav-sub__toggle[aria-expanded='true'] :global(svg) {
		transform: rotate(180deg);
	}
	nav ul.nav-sub {
		display: none;
		position: absolute;
		top: 100%;
		left: calc(-1 * var(--space-xs));
		z-index: var(--z-raised);
		flex-direction: column;
		gap: 0;
		min-width: 12rem;
		margin-top: var(--space-2xs);
		padding: var(--space-3xs);
		background-color: var(--theme-bg);
		border: 1px solid var(--theme-border);
		border-radius: var(--radius-md);
		box-shadow: var(--theme-elevation-2);
	}
	/* ponte invisibile sopra la tendina: il mouse attraversa lo spazio fra
	   voce e tendina senza che questa si chiuda */
	nav ul.nav-sub::before {
		content: '';
		position: absolute;
		inset: calc(-1 * var(--space-2xs)) 0 auto;
		height: var(--space-2xs);
	}
	.nav-voce--gruppo[data-aperto] ul.nav-sub {
		display: flex;
	}
	@media (hover: hover) and (min-width: 961px) {
		.nav-voce--gruppo:hover ul.nav-sub {
			display: flex;
		}
	}
	nav ul.nav-sub li a {
		padding: var(--space-2xs) var(--space-xs);
		border-radius: var(--radius-sm);
		white-space: nowrap;
		opacity: 0.8;
		transition: opacity var(--theme-transition),
			background-color var(--theme-transition);
	}
	nav ul.nav-sub li a:hover {
		opacity: 1;
		background-color: var(--theme-surface-1);
	}
	/* nella tendina il filetto in ottone non serve: basta il grassetto */
	nav ul.nav-sub li a::after {
		display: none;
	}
	nav ul.nav-sub li a[aria-current] {
		opacity: 1;
		font-weight: 600;
		color: var(--theme-primary);
	}

	/*
	  Menu a tutto schermo fino a 960px, non 600: logo, cinque voci e "Area
	  soci" in fila chiedono circa 900px, quindi un iPhone in orizzontale
	  (844-932px) mandava le voci su due righe.
	*/
	@media (max-width: 960px) {
		header.header--right {
			gap: var(--space-xs);
		}
		#menuButton {
			display: block;
			z-index: var(--z-sticky);
		}
		/* Con il menu chiuso la nav e' fuori dalla griglia: senza questo il
		   pulsante finiva nella colonna centrale invece che a destra. */
		.header-action-item__container {
			grid-column: 3;
			justify-self: end;
		}
		.header-nav__container {
			width: 100%;
			height: 100dvh;
			background-color: var(--theme-bg);
			display: none;
			flex-direction: column;
			align-items: center;
			position: fixed;
			inset: 0;
			z-index: calc(var(--z-sticky) - 1);
			/* in orizzontale le voci possono non stare in altezza: scorrono
			   sotto la barra invece di finirci dietro */
			padding: var(--menu-top, var(--navbar-height)) 0 var(--space-md);
			overflow-y: auto;
			overscroll-behavior: contain;
		}
		/* margin auto e non justify-content: center, che quando le voci non
		   stanno taglia la prima sotto la barra e la rende irraggiungibile */
		.header-nav__container nav {
			margin-block: auto;
		}
		header[mobile-menu-open] .header-nav__container {
			display: flex;
		}
		/* stretch, non center: cosi' le voci sono larghe uguali e le icone
		   formano una colonna invece di sfalsarsi seguendo il testo. */
		header[mobile-menu-open] nav ul {
			align-items: stretch;
			flex-direction: column;
			gap: var(--space-md);
		}
		header[mobile-menu-open] nav ul li a {
			display: flex;
			align-items: center;
			gap: var(--space-sm);
			font-family: var(--theme-font-family-serif);
			font-size: var(--font-size-lg);
			font-weight: 600;
		}
		header[mobile-menu-open] .nav-icona {
			display: block;
			flex: none;
			color: var(--theme-accent);
		}
		header[mobile-menu-open] .nav-voce > a {
			flex: 1;
		}
		/* Nel menu del telefono il sottomenu e' sempre aperto, rientrato
		   sotto la voce madre e allineato al suo testo (oltre l'icona). */
		.nav-sub__toggle {
			display: none;
		}
		header[mobile-menu-open] nav ul.nav-sub {
			display: flex;
			position: static;
			gap: 0;
			min-width: 0;
			margin: var(--space-2xs) 0 0;
			padding: 0 0 0 calc(22px + var(--space-sm));
			background: none;
			border: none;
			box-shadow: none;
		}
		header[mobile-menu-open] nav ul.nav-sub li a {
			padding: var(--space-3xs) 0;
			font-family: var(--theme-font-family-sans);
			font-size: var(--font-size-base);
			font-weight: 500;
		}
		header[mobile-menu-open] nav ul.nav-sub li a:hover {
			background: none;
		}
	}

	/* Telefono in orizzontale: poca altezza, voci piu' compatte */
	@media (max-width: 960px) and (max-height: 500px) {
		header[mobile-menu-open] nav ul {
			gap: var(--space-2xs);
		}
		header[mobile-menu-open] nav ul li a {
			font-size: var(--font-size-md);
		}
	}

	/*
	  Telefono in verticale: hamburger, logo e "Area soci" a misura piena non
	  stanno in 390-440px (iPhone 12-16), e il pulsante copriva "APS" e usciva
	  dal bordo. Si stringono pulsante e margini, non il nome della banda.
	*/
	@media (max-width: 600px) {
		header {
			padding-inline: var(--space-sm);
		}
		#menuButton {
			margin-right: var(--space-3xs);
		}
		.header-action-item__container :global(a) {
			padding: 0.5rem 0.8rem;
			white-space: nowrap;
		}
	}
	/* iPhone SE di prima generazione (320px) */
	@media (max-width: 350px) {
		header.header--right {
			gap: var(--space-2xs);
		}
		#menuButton {
			margin-right: 0;
		}
		.header-action-item__container :global(a) {
			padding: 0.45rem 0.6rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		nav ul li a::after {
			transition: none;
		}
	}
</style>
