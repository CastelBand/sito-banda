{
	"extends": "astro/tsconfigs/base",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", ".vercel"],
	"compilerOptions": {
		"experimentalDecorators": true,
		"useDefineForClassFields": false,
		"strict": false,
		"baseUrl": "src",
		"paths": {
			"@config/*": ["config/*"],
			"@icons/*": ["icons/*"],
			"@lib/*": ["lib/*"],
			"@utils/*": ["utils/*"],
			"@components/*": ["components/*"],
			"@layouts/*": ["layouts/*"],
			"@assets/*": ["assets/*"],
			"@pages/*": ["pages/*"],
			"@styles/*": ["styles/*"]
		}
	}
}
